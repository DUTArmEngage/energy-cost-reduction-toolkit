#!/bin/sh
# Create the app's own virtualenv, install the wheel (and its dependencies from PyPI) into it, then start the service.
set -e
APP=/usr/lib/@NAME@
if [ "$1" = "configure" ]; then
    python3 -m venv "$APP/venv"
    "$APP/venv/bin/pip" install --quiet --no-cache-dir "$APP"/*.whl
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        systemctl enable @NAME@.service || true
        systemctl restart @NAME@.service || true          # starts it on a fresh install, restarts it on an upgrade
    fi
fi
exit 0
