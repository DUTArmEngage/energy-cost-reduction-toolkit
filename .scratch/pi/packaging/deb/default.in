# ECRT dashboard settings. After editing: sudo systemctl restart @NAME@
#
#ECRT_FEED=mock            # mock, or serial for the real Uno
#ECRT_PORT=/dev/ttyACM0    # serial port (only used when ECRT_FEED=serial)
#ECRT_BAUD=115200
#
# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from the network, but the page can switch relays and has no login:
# only do that on a network you trust.
#ECRT_BIND=127.0.0.1
#ECRT_HTTP_PORT=8501
