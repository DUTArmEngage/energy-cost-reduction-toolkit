[Unit]
Description=ECRT Raspberry Pi dashboard
After=network.target

[Service]
# Defaults. Override in /etc/default/@NAME@ (read after these lines), then: sudo systemctl restart @NAME@
Environment=ECRT_PORT=/dev/ttyACM0 ECRT_BAUD=115200 ECRT_BIND=0.0.0.0 ECRT_HTTP_PORT=8501
EnvironmentFile=-/etc/default/@NAME@
Environment=HOME=/var/lib/@NAME@
ExecStart=/usr/bin/ecrt-ui --server.headless true --server.address ${ECRT_BIND} --server.port ${ECRT_HTTP_PORT}
Restart=on-failure
RestartSec=3

# A throwaway user, in the group that owns serial ports, with its own state directory.
DynamicUser=yes
SupplementaryGroups=dialout
StateDirectory=@NAME@
NoNewPrivileges=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
